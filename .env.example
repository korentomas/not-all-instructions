# Copy this file to `.env` (gitignored); Inspect loads it automatically.
# Fill in only what the providers in models.toml actually use.

# OpenRouter: every candidate plus the Anthropic (Claude) judge route through it.
OPENROUTER_API_KEY=

# Azure AI Foundry: the Mistral and Grok judges. Auth is KEYLESS (Entra ID) -
# run `az login` and hold the "Cognitive Services User" role on the resource.
# Only the endpoint URL goes here, never a key.
AZUREAI_BASE_URL=
